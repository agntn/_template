// `pnpm typecheck` runs this after the build: the tests import the extensions and their `dist` types.
// Vitest only strips types, so nothing else checks `test/`.
{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": ".."
  },
  "include": ["**/*.ts"],
  "exclude": ["../node_modules", "../dist"]
}
