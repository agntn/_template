{
  "name": "template-ts",
  "version": "0.0.0",
  "description": "",
  "homepage": "https://github.com/oritwoen/template-ts#readme",
  "bugs": "https://github.com/oritwoen/template-ts/issues",
  "license": "MIT",
  "author": "oritwoen (https://github.com/oritwoen)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oritwoen/template-ts.git"
  },
  "bin": {
    "template-ts": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "packages/omp/extensions",
    "packages/pi/extensions"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./ai": {
      "types": "./dist/ai.d.mts",
      "import": "./dist/ai.mjs"
    },
    "./mcp": {
      "types": "./dist/mcp.d.mts",
      "import": "./dist/mcp.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "lint": "pnpm build && vp lint && vp fmt --check",
    "lint:fix": "pnpm build && vp lint --fix && vp fmt",
    "typecheck": "tsc --noEmit --skipLibCheck && pnpm build && tsc -p tsconfig.extensions.json && tsc -p test/tsconfig.json",
    "test": "vp test run",
    "test:watch": "vp test watch",
    "prepack": "pnpm run build",
    "release": "pnpm test && pnpm build && changelogen --release --push"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "citty": "0.2.2",
    "consola": "3.4.2",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@agntn/ox": "0.1.0",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@oh-my-pi/omptype": "18.0.0",
    "@oh-my-pi/pi-coding-agent": "18.0.0",
    "@types/node": "26.2.0",
    "ai": "7.0.66",
    "changelogen": "0.6.2",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.2 <1",
    "@oh-my-pi/pi-coding-agent": ">=18.0.0 <19",
    "ai": ">=7.0.0",
    "typebox": ">=1.3.14 <2",
    "zod": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@11.22.0",
  "omp": {
    "extensions": [
      "./packages/omp/extensions/template.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./packages/pi/extensions/template.ts"
    ]
  }
}
