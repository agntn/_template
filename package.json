{
  "name": "template-ts",
  "version": "0.0.0",
  "description": "",
  "homepage": "https://github.com/oritwoen/template-ts#readme",
  "bugs": "https://github.com/oritwoen/template-ts/issues",
  "license": "MIT",
  "author": "oritwoen (https://github.com/oritwoen)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oritwoen/template-ts.git"
  },
  "bin": {
    "template-ts": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "packages/pi/extensions"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./ai": {
      "types": "./dist/ai.d.mts",
      "import": "./dist/ai.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "obuild",
    "dev": "obuild --stub",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint . --fix && oxfmt .",
    "typecheck": "tsc --noEmit --skipLibCheck && tsc -p tsconfig.extensions.json",
    "test": "vitest --run",
    "test:watch": "vitest",
    "prepack": "pnpm run build",
    "release": "pnpm test && pnpm build && changelogen --release --push"
  },
  "dependencies": {
    "citty": "0.2.2",
    "consola": "3.4.2"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@types/node": "26.2.0",
    "ai": "7.0.66",
    "changelogen": "0.6.2",
    "obuild": "0.4.38",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "typebox": "1.3.14",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "ai": ">=7.0.0",
    "typebox": "*",
    "zod": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "typebox": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0",
  "pi": {
    "extensions": [
      "./packages/pi/extensions/template.ts"
    ]
  }
}
